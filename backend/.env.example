# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/byjus_streak_db?schema=public"

# Firebase Admin SDK Configuration
# Option 1: Path to Firebase Service Account JSON file (recommended for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"

# Option 2: Discrete Environment Variables (recommended for cloud deployments like Render, Heroku, Railway)
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Option 3: Full JSON string / Base64 of service account key
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
