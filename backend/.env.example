# ─────────────────────────────────────────────
# Backend Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────

# ── Server ──────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (PostgreSQL) ────────────────────
# Local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/byjus_streak_db?schema=public"
# Docker (uses service hostname 'postgres'):
# DATABASE_URL="postgresql://byjus:byjus_secret@postgres:5432/byjus_streak?schema=public"

# ── Redis ───────────────────────────────────
# Local development:
REDIS_URL=redis://127.0.0.1:6379
# Docker (uses service hostname 'redis'):
# REDIS_URL=redis://redis:6379

# ── Security ────────────────────────────────
# REQUIRED in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret

# ── CORS ────────────────────────────────────
# Origin(s) allowed by CORS. In Docker: the Nginx frontend URL.
FRONTEND_URL=http://localhost

# ── Firebase Admin SDK ──────────────────────
# Option A: Local dev — path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"

# Option B: Docker / cloud — discrete environment variables (recommended)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Option C: Full JSON string / Base64 of service account key
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
