# ──────────────────────────────────────────────────────────
# Root .env.example  –  used by docker-compose.yml
# Copy this file to .env and fill in your actual values.
# DO NOT commit the real .env to version control.
# ──────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=byjus_streak_db

# ── JWT ─────────────────────────────────────────────────────
# Use a strong random string (min 32 chars) in production
JWT_SECRET=changeme_supersecret_jwt_key_32chars

# ── Firebase (optional – leave blank if using local JWT auth) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Frontend (build-time) ────────────────────────────────────
# URL that the browser uses to reach the backend.
# In Docker Compose, Nginx proxies /api/* -> backend so keep as localhost:80
# For external deployment, set this to your actual backend URL.
VITE_API_URL=http://localhost:5000
